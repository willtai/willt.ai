---
import { SITE, SOCIALS } from "../data/site";
---

<header id="top" class="hero">
  <img
    src={SITE.photo}
    alt={SITE.name}
    width="64"
    height="64"
    class="hero-photo"
    loading="eager"
  />
  <h1 class="name">{SITE.name}<span class="cursor" aria-hidden="true">_</span></h1>
  <p class="tagline">{SITE.tagline}</p>
  <p class="links">
    {SOCIALS.map((social) => (
      <a class="ulink" href={social.url} target="_blank" rel="noopener noreferrer">
        {social.label}
      </a>
    ))}
  </p>
</header>
