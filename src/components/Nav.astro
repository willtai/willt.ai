---
const sections = [
  { id: "top", label: "Home" },
  { id: "experience", label: "Experience" },
  { id: "projects", label: "Projects" },
  { id: "contact", label: "Contact" },
];
---

<nav id="site-nav" class="nav" aria-label="Sections">
  {sections.map((section, i) => (
    <a
      href={`#${section.id}`}
      class="nav-link"
      data-section={section.id}
      aria-current={i === 0 ? "true" : "false"}
    >
      {section.label}
    </a>
  ))}
</nav>
