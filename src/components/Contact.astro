---
import { SITE, SOCIALS } from "../data/site";

const [emailUser, emailDomain] = SITE.email.split("@");
---

<section id="contact" class="fog fog-contact" aria-labelledby="contact-title">
  <h2 id="contact-title" class="sec-title">Get in touch</h2>
  <button
    id="copy-email"
    type="button"
    class="mail"
    data-user={emailUser}
    data-domain={emailDomain}
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
      <path d="M3.5 6.5h17v11h-17z" stroke-linejoin="round" />
      <path d="M4 7l8 6 8-6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <span class="mail-label">Get in touch</span>
    <span class="mail-status">
      <span class="mail-hint">click to copy email</span>
      <span id="copy-toast" class="copy-toast" aria-live="polite">copied!</span>
    </span>
  </button>
  <p class="links">
    {SOCIALS.map((social) => (
      <a class="ulink" href={social.url} target="_blank" rel="noopener noreferrer">
        {social.label}
      </a>
    ))}
  </p>
</section>
