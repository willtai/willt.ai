---
import { EXPERIENCE, EDUCATION } from "../data/site";
---

<section id="experience" class="fog fog-exp" aria-labelledby="experience-title">
  <h2 id="experience-title" class="sec-title">Experience</h2>
  <div class="roles">
    {EXPERIENCE.map((exp, i) => {
      const inner = (
        <>
          <span class="tile">
            <img src={exp.logo} alt={exp.company} width="24" height="24" loading="lazy" />
          </span>
          <span class="who">
            <span class="role-title">
              {exp.role}
              {i === 0 && <span class="chip">current</span>}
            </span>
            <span class="role-org">{exp.company}</span>
          </span>
          {exp.url !== "" ? (
            <svg class="go" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M7 17L17 7M17 7H8M17 7v9" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          ) : (
            <span />
          )}
        </>
      );
      return exp.url !== "" ? (
        <a class="role" href={exp.url} target="_blank" rel="noopener noreferrer">{inner}</a>
      ) : (
        <div class="role">{inner}</div>
      );
    })}
  </div>

  <h2 class="sec-title sec-title-2">Education</h2>
  <div class="roles">
    {EDUCATION.map((edu) => {
      const inner = (
        <>
          <span class="tile">
            <img src={edu.logo} alt={edu.institution} width="24" height="24" loading="lazy" />
          </span>
          <span class="who">
            <span class="role-title">{edu.degree}</span>
            <span class="role-org">{edu.institution}</span>
          </span>
          {edu.url !== "" ? (
            <svg class="go" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M7 17L17 7M17 7H8M17 7v9" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          ) : (
            <span />
          )}
        </>
      );
      return edu.url !== "" ? (
        <a class="role" href={edu.url} target="_blank" rel="noopener noreferrer">{inner}</a>
      ) : (
        <div class="role">{inner}</div>
      );
    })}
  </div>
</section>
